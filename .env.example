# Copy to .env and fill in. .env is gitignored.

# One or more Codeberg / Forgejo accounts as a JSON object of {name: token}.
# Generate tokens at: https://codeberg.org/user/settings/applications
# Scopes depend on what you use: read/write:repository, read/write:issue, read:user.
CODEBERG_ACCOUNTS={"personal": "your_token_here", "work": "another_token_here"}

# Optional: which account name is used when a tool call omits `account`.
# Defaults to the first key in CODEBERG_ACCOUNTS if unset.
# CODEBERG_DEFAULT_ACCOUNT=personal

# Optional transport / network settings (see README):
# MCP_TRANSPORT=stdio    # stdio | http (default) | sse
# HOST=0.0.0.0
# PORT=8000
